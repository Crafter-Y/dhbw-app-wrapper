{
  "expo": {
    "name": "DHBW App Wrapper",
    "slug": "dhbw-app-wrapper",
    "description": "This app just embeds the dhbw.app website in a webview.",
    "githubUrl": "https://github.com/Crafter-Y/dhbw-app-wrapper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dhbwappwrapper",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#213350",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.craftery.dhbwappwrapper"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64499c4b-342b-43f7-aa73-e27fdd572191"
      }
    }
  }
}
